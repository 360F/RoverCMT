{
  "name": "rovercmt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && node tools/copy-ocr-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke": "npm run build && node --test tests/smoke.test.mjs",
    "check:boundaries": "node tests/boundaries.mjs",
    "validate:detect": "npm run build && node dist/validate-detect.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "dependencies": {
    "onnxruntime-node": "1.27.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "^0.6.0"
    }
  }
}
